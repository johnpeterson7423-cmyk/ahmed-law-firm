<% content_for :title, "Workspace — Ahmed Law Firm" %>
<% content_for :body_class, "page-workspace" %>

<section class="workspace">
  <div class="workspace__intro">
    <div class="anim-rise">
      <p class="eyebrow"><span class="eyebrow__dot"></span> Workspace</p>
      <h1>Firm records</h1>
      <p class="lede">
        <% if demo_mode? %>
          Search, filter, and sort your uploaded demo spreadsheet.
        <% else %>
          Search, filter, and sort your firm's live Google Sheet.
        <% end %>
      </p>
    </div>

    <div class="workspace__stats anim-rise anim-rise--1">
      <div class="stat glass-card">
        <span class="stat__value"><%= @total_count %></span>
        <span class="stat__label"><%= active_filters? ? "matching rows" : "total rows" %></span>
      </div>
      <div class="stat glass-card">
        <span class="stat__value"><%= @page %><span class="stat__slash">/</span><%= @total_pages %></span>
        <span class="stat__label">page</span>
      </div>
    </div>
  </div>

  <%= form_with url: sheets_path, method: :get, local: true, class: "filters glass-card anim-rise anim-rise--2" do %>
    <div class="filters__row">
      <div class="field field--grow">
        <label for="query">Search</label>
        <%= text_field_tag :query, params[:query],
              id: "query",
              placeholder: "Client, phone, claim number…",
              class: "input" %>
      </div>

      <div class="field">
        <label for="insurance">Insurance</label>
        <%= select_tag :insurance,
              options_for_select(@insurances, params[:insurance]),
              include_blank: "All insurers",
              id: "insurance",
              class: "input" %>
      </div>

      <div class="field">
        <label for="status">Status</label>
        <%= select_tag :status,
              options_for_select(
                [["All statuses", ""]] + @statuses.map { |s| [s, s] },
                params[:status]
              ),
              id: "status",
              class: "input" %>
      </div>

      <%= hidden_field_tag :sort, params[:sort] %>
      <%= hidden_field_tag :direction, params[:direction] %>

      <div class="filters__actions">
        <%= submit_tag "Apply", class: "btn btn--primary btn--glow" %>
        <%= link_to "Reset", sheets_path, class: "btn btn--ghost" %>
      </div>
    </div>
  <% end %>

  <div class="toolbar anim-rise anim-rise--3">
    <div class="toolbar__meta">
      <% if active_filters? %>
        <span class="chip chip--live">Filters active</span>
      <% else %>
        <span class="chip chip--muted">All <%= @total_count %> rows</span>
      <% end %>
    </div>
  </div>

  <% if @users.any? %>
    <div class="table-wrap glass-card anim-rise anim-rise--4">
      <table class="data-table data-table--wide">
        <thead>
          <tr>
            <% @columns.each do |column| %>
              <th>
                <%= link_to sheets_path(filter_query_params(sort: column, direction: next_sort_direction(column), page: 1)),
                            class: "sort-link" do %>
                  <%= column_label(column) %><%= sort_indicator(column) %>
                <% end %>
              </th>
            <% end %>
            <% unless demo_mode? %>
              <th>File</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @users.each_with_index do |user, index| %>
            <tr class="table-row" style="--row-i: <%= index %>">
              <% @columns.each do |column| %>
                <td class="<%= "mono" if %w[phone_number dol dob].include?(column) %>">
                  <% if column == "treatment_status" %>
                    <span class="<%= status_badge_class(user[column]) %>">
                      <%= user[column].presence || "—" %>
                    </span>
                  <% else %>
                    <%= format_cell(column, user[column]) %>
                  <% end %>
                </td>
              <% end %>
              <% unless demo_mode? %>
                <td>
                  <% if user["clients"].present? %>
                    <%= link_to "See File",
                                document_sheets_path(client: user["clients"], dol: user["dol"]),
                                class: "btn btn--ghost btn--sm" %>
                  <% else %>
                    <span class="chip chip--muted">—</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <nav class="pagination anim-rise anim-rise--5" aria-label="Pagination">
        <% if @page > 1 %>
          <%= link_to "← Prev", sheets_path(filter_query_params(page: @page - 1)), class: "pagination__link" %>
        <% end %>

        <% pagination_items(@page, @total_pages).each do |page| %>
          <% if page == :gap %>
            <span class="pagination__gap">…</span>
          <% else %>
            <%= link_to page,
                        sheets_path(filter_query_params(page: page)),
                        class: "pagination__link #{"is-active" if page == @page}" %>
          <% end %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to "Next →", sheets_path(filter_query_params(page: @page + 1)), class: "pagination__link" %>
        <% end %>
      </nav>
    <% end %>
  <% else %>
    <div class="empty-state glass-card anim-rise anim-rise--4">
      <h2>No matching rows</h2>
      <p>Try a different search term, clear a filter, or reset to see the full sheet.</p>
      <%= link_to "Clear filters", sheets_path, class: "btn btn--primary btn--glow" %>
    </div>
  <% end %>
</section>
