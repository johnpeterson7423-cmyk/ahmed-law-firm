    <div class="contact__form-card glass-card" data-controller="contact-form">
      <form class="contact__form" data-contact-form-target="form" data-action="submit->contact-form#submit">
        <div class="contact__form-row">
          <div class="contact__field">
            <label for="contact-name">Full name</label>
            <input id="contact-name" class="input" autocomplete="name" required type="text" name="name">
          </div>
          <div class="contact__field">
            <label for="contact-phone">Phone</label>
            <input id="contact-phone" class="input" autocomplete="tel" required inputmode="numeric" pattern="[0-9]+" type="tel" name="phone">
          </div>
        </div>

        <div class="contact__form-row">
          <div class="contact__field">
            <label for="contact-email">Email</label>
            <input id="contact-email" class="input" autocomplete="email" type="email" name="email">
          </div>
          <div class="contact__field">
            <label for="contact-practice-area">Practice area</label>
            <select id="contact-practice-area" class="input" name="practice_area">
              <option value="" disabled selected>Select an area</option>
              <option value="auto-accidents">Auto / Car accident</option>
              <option value="construction">Construction accident</option>
              <option value="slip-fall">Slip &amp; fall</option>
              <option value="medical-malpractice">Medical malpractice</option>
              <option value="other">Other injury</option>
            </select>
          </div>
        </div>

        <div class="contact__field">
          <label for="contact-message">Brief description of your case</label>
          <textarea id="contact-message" class="input" name="message" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--glow contact__submit">Submit to our attorneys</button>
        <p class="contact__disclaimer">By submitting, you agree that this form does not create an attorney&ndash;client relationship and no confidential information should be included.</p>
      </form>

      <div class="contact__success" data-contact-form-target="success" hidden>
        <p>Thanks &mdash; your message has been received. Our team will reach out shortly.</p>
      </div>
    </div>
  </div>
</section>
