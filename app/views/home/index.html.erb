          </div>
          <span class="practice__card-title">Vehicle Accidents</span>
        </a>
      </div>

      <div class="practice__card-wrap" data-slider-target="loopSlide" aria-hidden="true">
        <a class="practice__card" href="#" tabindex="-1">
          <div class="practice__card-image">
            <%= image_tag "truck-accidents-0QxpHGms.webp", alt: "", class: "practice__card-img" %>
