<section class="reviews" data-controller="reviews" aria-label="What Our Clients Say">
  <div class="reviews__intro anim-rise">
    <p class="reviews__label">Testimonials</p>
    <h2 class="reviews__heading">What Our Clients <span class="text-gradient">Say</span></h2>
  </div>

  <div class="reviews__card glass-card anim-rise anim-rise--1" role="group" aria-roledescription="carousel">
    <span class="reviews__mark" aria-hidden="true">&#8220;</span>

    <div class="reviews__stack">
      <div class="reviews__slide reviews__slide--active" data-reviews-target="slide">
        <p class="reviews__quote">&quot;The Ahmed Law Firm helped me recover $250,000 after my car accident. Their team was professional, caring, and fought hard for my rights.&quot;</p>
        <p class="reviews__name">M. R.</p>
      </div>

      <div class="reviews__slide" data-reviews-target="slide">
        <p class="reviews__quote">&quot;After my slip and fall injury, Ahmed Law got me a $1,200,000 settlement. They handled everything while I focused on recovery.&quot;</p>
        <p class="reviews__name">J. T.</p>
      </div>

      <div class="reviews__slide" data-reviews-target="slide">
        <p class="reviews__quote">&quot;Medical malpractice case resulted in $850,000 recovery. The team at Ahmed Law Firm are exceptional attorneys who truly care.&quot;</p>
        <p class="reviews__name">P. W.</p>
      </div>
    </div>
  </div>

  <div class="reviews__dots" role="tablist">
    <button type="button" class="reviews__dot reviews__dot--active" data-reviews-target="dot" data-action="reviews#show" data-index="0" aria-label="Show testimonial 1" aria-current="true"></button>
    <button type="button" class="reviews__dot" data-reviews-target="dot" data-action="reviews#show" data-index="1" aria-label="Show testimonial 2"></button>
    <button type="button" class="reviews__dot" data-reviews-target="dot" data-action="reviews#show" data-index="2" aria-label="Show testimonial 3"></button>
  </div>
</section>

