      <div class="practice__card-wrap" data-slider-target="slide">
        <a class="practice__card" href="#">
          <div class="practice__card-image">
            <%= image_tag "Personal-injury-3UGlWDlj.webp", alt: "Personal Injury practice area", class: "practice__card-img" %>
          </div>
          <span class="practice__card-title">Personal Injury</span>
        </a>
      </div>

      <div class="practice__card-wrap" data-slider-target="slide">
        <a class="practice__card" href="#">
