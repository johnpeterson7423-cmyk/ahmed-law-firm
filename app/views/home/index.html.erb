<% content_for :title, "Ahmed Law Firm — Workspace" %>
<% content_for :body_class, "page-home" %>

<section class="hero">
  <div class="hero__content">
    <p class="hero__brand anim-rise">Ahmed Law Firm P.C.</p>
    <h1 class="hero__headline anim-rise anim-rise--1">
      Filter smarter<br>
      <span class="text-gradient">Follow up faster</span>
    </h1>
    <p class="hero__lede anim-rise anim-rise--2">
      A smarter way to manage your client roster.Automate filtering, find who needs attention,
      and keep every case moving forward.
    </p>

    <div class="hero__actions anim-rise anim-rise--3">
      <% if current_user || demo_mode? %>
        <%= link_to "Enter workspace", sheets_path, class: "btn btn--primary btn--lg btn--glow" %>
      <% else %>
        <%= link_to "Continue with Google", login_path, class: "btn btn--primary btn--lg btn--glow" %>
        <%= link_to "Try a demo with your own file", new_demo_path, class: "btn btn--ghost btn--lg" %>
      <% end %>
      <span class="hero__meta">Secure OAuth · Live Sheets</span>
    </div>
  </div>

  <div class="hero__visual anim-rise anim-rise--2" aria-hidden="true">
    <div class="sheet-preview">
      <div class="sheet-preview__scan"></div>
      <div class="sheet-preview__bar">
        <span></span><span></span><span></span>
        <p class="sheet-preview__title">roster · live</p>
        <span class="sheet-preview__badge">SYNCED</span>
      </div>
      <div class="sheet-preview__grid">
        <div class="sheet-preview__cell sheet-preview__cell--head">ID</div>
        <div class="sheet-preview__cell sheet-preview__cell--head">Name</div>
        <div class="sheet-preview__cell sheet-preview__cell--head">Status</div>

        <div class="sheet-preview__cell sheet-preview__row" style="--i:1">1001</div>
        <div class="sheet-preview__cell sheet-preview__row" style="--i:1">Ali Khan</div>
        <div class="sheet-preview__cell sheet-preview__row sheet-preview__cell--live" style="--i:1">Active</div>

        <div class="sheet-preview__cell sheet-preview__row" style="--i:2">1012</div>
        <div class="sheet-preview__cell sheet-preview__row" style="--i:2">Emma Johnson</div>
        <div class="sheet-preview__cell sheet-preview__row sheet-preview__cell--live" style="--i:2">Active</div>

        <div class="sheet-preview__cell sheet-preview__row" style="--i:3">1014</div>
        <div class="sheet-preview__cell sheet-preview__row" style="--i:3">Olivia Brown</div>
        <div class="sheet-preview__cell sheet-preview__row sheet-preview__cell--mute" style="--i:3">Inactive</div>
      </div>
    </div>
  </div>
</section>

