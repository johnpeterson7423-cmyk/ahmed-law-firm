  <div class="practice__dots">
    <button type="button" class="practice__dot practice__dot--active" data-slider-target="dot" data-action="slider#goTo" data-index="0" aria-label="Go to slide 1" aria-current="true"></button>
    <button type="button" class="practice__dot" data-slider-target="dot" data-action="slider#goTo" data-index="1" aria-label="Go to slide 2"></button>
