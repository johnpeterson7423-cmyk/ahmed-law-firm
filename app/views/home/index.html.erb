<section class="performance">
  <div class="performance__content">
    <div class="performance__text anim-rise">
      <p class="performance__label">Our Performance</p>
      <h2 class="performance__heading">
        Across 1000's Of Cases,<br>
        <span class="text-gradient">10 Million+ Recovered</span>
      </h2>
      <p class="performance__footnote">
        *Industry averages track the field. Our 98% rate represents the standard within the complex litigation we navigate.
      </p>
    </div>

    <div class="performance__achievements anim-rise anim-rise--1">
      <div class="performance__card glass-card">
        <div class="performance__amount" data-controller="counter">$1,500,000</div>
        <p class="performance__desc">Slip and Fall Settlement</p>
      </div>
      <div class="performance__card glass-card">
        <div class="performance__amount" data-controller="counter">$1,200,000</div>
        <p class="performance__desc">Trip and Fall Verdict</p>
      </div>
      <div class="performance__card glass-card">
        <div class="performance__amount" data-controller="counter">$1,100,000</div>
        <p class="performance__desc">Premises Liability Settlement</p>
      </div>
      <div class="performance__card glass-card">
        <div class="performance__amount" data-controller="counter">$300,000</div>
        <p class="performance__desc">Auto Accident Settlement</p>
      </div>
    </div>
  </div>
</section>

<section class="practice" data-controller="slider">
  <div class="practice__intro anim-rise">
    <p class="practice__label">Practice Areas</p>
    <h2 class="practice__heading">Our Practice Areas, <span class="text-gradient">All In One Place</span></h2>
  </div>

  <div class="practice__slider-wrap anim-rise anim-rise--1">
